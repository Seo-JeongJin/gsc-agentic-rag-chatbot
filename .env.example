# 환경변수 견본 — git에 올라가는 파일. 실제 값은 넣지 말 것.
# 사용법: 이 파일을 복사해서 같은 폴더에 .env로 저장한 뒤 값을 채움
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL 접속 정보 — docker-compose.yml의 db 컨테이너 생성과 backend/mcp_server 접속에 공통으로 쓰임
# ---------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# ---------------------------------------------------------------------------
# 생성 LLM (backend) — 어디서 답변을 만들지
#   mock : 가짜 응답(집에서 GPU 서버 없이 개발/테스트할 때). 기본값.
#   vllm : 학과 GPU 서버의 vLLM 호출(학교 실측/운영). 아래 VLLM_URL/VLLM_MODEL 필요.
# ---------------------------------------------------------------------------
LLM_MODE=mock
# GPU 서버의 생성 모델 vLLM 주소(포트 8000). 예: http://<GPU서버 주소>:8000  — 끝에 /v1은 붙이지 않음
VLLM_URL=
# vLLM이 서빙 중인 모델 이름. 정확한 값은 GPU 서버에서 `curl http://<GPU서버 주소>:8000/v1/models`로 확인
VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# ---------------------------------------------------------------------------
# 임베딩 모델 (mcp_server) — 문장을 벡터로 바꾸는 계산을 어디서 할지
#   local : 이 컴퓨터의 Docker 안에서 CPU로 BGE-M3 실행(집). 기본값. 첫 임베딩 때 모델 파일(약 4GB) 다운로드.
#   vllm  : 학과 GPU 서버의 vLLM 임베딩 호출(학교). 아래 EMBEDDING_URL 필요, 모델 다운로드 없음.
# ※ 모드를 바꾸면 문서를 다시 색인할 것(같은 BGE-M3라도 계산 환경이 바뀌었으니 확인 차원):
#   docker compose exec mcp_server python3 index_cli.py /data/<문서파일>.md
# ---------------------------------------------------------------------------
EMBEDDING_MODE=local
# GPU 서버의 임베딩 vLLM 주소(포트 8001). 예: http://<GPU서버 주소>:8001
EMBEDDING_URL=
EMBEDDING_MODEL=BAAI/bge-m3
